          "activeProfile": "mac-pyocd"
        }
      },
      "twisterConfigs": {},
      "confFiles": {
        "config": [],
        "overlay": []
      }
    }
  },
  "activeProject": "app",
  "runnerProfiles": [
    {
      "name": "windows-pyocd",
      "flash": {
        "kind": "west-flash",
        "runner": "pyocd"
      },
      "debug": {
        "kind": "launch",
        "name": "Zephyr IDE: Debug (Windows/WSL2 local pyocd)"
