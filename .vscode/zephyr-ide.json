{
  "projects": {
    "app": {
      "relPath": "app",
      "name": "app",
      "buildConfigs": {
        "build/demo": {
          "name": "build/demo",
          "board": "demo",
          "relBoardDir": "boards",
          "relBoardSubDir": "demo",
          "westBuildArgs": [],
