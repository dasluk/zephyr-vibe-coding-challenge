/dts-v1/;
#include <st/u3/stm32u385Xg.dtsi>
#include <st/u3/stm32u385rgtxq-pinctrl.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/sensor/lsm6dso16is.h>

/ {
	model = "Workshop Demo Board";
	compatible = "demo";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	/*
	 * Board I/O: onboard user button (B1).
	 *
	 * Pin confirmed as PC13 / GPIO_ACTIVE_HIGH against ST's own upstream
	 * Zephyr board port for this exact SoC/package
	 * (external/zephyr/boards/st/nucleo_u385rg_q/nucleo_u385rg_q.dts,
	 * which this "demo" board's dts is otherwise a trimmed-down copy of),
	 * cross-checked against ST's Nucleo-64 user manual (UM3062,
	 * STM32U3/U5 Nucleo-64 boards MB1841) via web search. Not assumed
	 * from the generic Nucleo-64 PC13 convention alone.
	 */
	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User (B1)";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		accelerometer = &lsm6dso16is;
		sw0 = &user_button;
		buzzer = &pwm1;
	};
};

/*
 * Board I/O: buzzer PWM output, Arduino header D8 / PC7 / TIM3 channel 2
 * (see intent.md and specs/board-io.spec.md).
 *
 * st,prescaler = 95 divides the ~96MHz timer input clock down to a 1MHz
 * counter tick, giving pwm_set()/buzzer_request() a usable audible-range
 * resolution (~15Hz .. 500kHz, ARR 16-bit) without needing a slower clock.
 */
&timers3 {
	st,prescaler = <95>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim3_ch2_pc7>;
		pinctrl-names = "default";
		status = "okay";
	};
};

// MSIS requires LSE clock to be enabled for auto-calibration
&clk_lse {
	status = "okay";
};

// Currently unused, but produces compiler warning if disabled
&clk_msik {
	status = "okay";
};

&clk_msis {
	status = "okay";
	msi-pll-mode;
	msi-range = <0>; /* 96MHz (reset value) */
};

&rcc {
	clocks = <&clk_msis>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb13 &i2c2_sda_pb14>; // Arduino D15 + D14
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	lsm6dso16is: lsm6dso16is@6a {
		compatible = "st,lsm6dso16is";
		reg = <0x6a>;
		accel-range = <LSM6DSO16IS_DT_FS_4G>;
		accel-odr = <LSM6DSO16IS_DT_ODR_104Hz_HP>;
		gyro-range = <LSM6DSO16IS_DT_FS_500DPS>;
		gyro-odr = <LSM6DSO16IS_DT_ODR_104Hz_HP>;
		status = "okay";
	};
};
